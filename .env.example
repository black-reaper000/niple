# LAN Audio Configuration

# Audio Streaming Port (UDP)
AUDIO_PORT=40000

# Control, Ping, and Volume Port (UDP)
CONTROL_PORT=40001

# Sender Settings
# Target IP of macOS receiver: IP address or "auto" to use mDNS Bonjour discovery
SENDER_TARGET_IP=auto

# Audio Codec: "opus" (compressed, low-bandwidth, 2.5-10ms algorithmic delay) or "pcm" (uncompressed, absolute lowest latency on gigabit LAN)
CODEC_MODE=opus

# Audio Frame Size in milliseconds: 2.5, 5, 10, or 20 (recommended: 10 with 20ms jitter buffer, or 5 with 15ms buffer)
FRAME_SIZE_MS=10

# Windows Audio Capture Device: substring name filter (e.g. "CABLE Input", "NVIDIA"), or leave blank for default output device loopback
AUDIO_DEVICE=

# Receiver Settings
# Adaptive Jitter Buffer target latency in milliseconds (default: 20, range: 5 - 100)
JITTER_BUFFER_MS=20

# macOS Playback Output Device: substring name filter (e.g. "MacBook Pro Speakers"), or leave blank for default output device
RECEIVER_DEVICE=

# Optional Dashboard Settings
# Whether to launch the local self-signed HTTPS dashboard on the receiver (true/false)
DASHBOARD_ENABLED=true

# Dashboard Port (HTTPS)
DASHBOARD_PORT=8443
